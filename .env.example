# --- Shopify Partner App credentials ---
# Get these from your app in the Shopify Partner Dashboard (Apps > your app > Client credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Comma-separated Admin API scopes this app needs
SHOPIFY_SCOPES=write_products,read_products,write_content,read_content,write_themes,read_themes,write_online_store_pages,read_online_store_pages,write_publications,read_publications
# Must match the App URL configured in the Partner Dashboard, no trailing slash
SHOPIFY_APP_URL=https://your-app-domain.example.com

# --- AI (Claude) ---
ANTHROPIC_API_KEY=

# --- AI image generation (KIE AI, gpt-image-2), used by the wizard's Materials step ---
KIE_API_KEY=

# --- Shopify CLI theme push (used by the wizard's Push step to write theme
# code automatically — bypasses the Admin API's theme-file write restriction) ---
# Install the free "Theme Access" app on your store (https://apps.shopify.com/theme-access),
# generate a password there, and paste it here. Requires the Shopify CLI:
# `npm install -g @shopify/cli`. If unset, the push step falls back to a blank
# Dawn copy + manual paste-in instructions in the UI.
SHOPIFY_THEME_ACCESS_TOKEN=

# --- Database ---
DATABASE_URL="file:./dev.db"
