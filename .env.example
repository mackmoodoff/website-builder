# --- Shopify Partner App credentials ---
# Get these from your app in the Shopify Partner Dashboard (Apps > your app > Client credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Comma-separated Admin API scopes this app needs
SHOPIFY_SCOPES=write_products,read_products,write_content,read_content,write_themes,read_themes,write_online_store_pages,read_online_store_pages
# Must match the App URL configured in the Partner Dashboard, no trailing slash
SHOPIFY_APP_URL=https://your-app-domain.example.com

# --- AI (Claude) ---
ANTHROPIC_API_KEY=

# --- AI image generation (OpenAI gpt-image-1), used by the wizard's Materials step ---
OPENAI_API_KEY=

# --- Database ---
DATABASE_URL="file:./dev.db"
